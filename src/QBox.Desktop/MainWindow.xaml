<Window x:Class="QBox.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QBox.Desktop"
        Title="QBox 搜索" Width="640" Height="72" MinWidth="480" MinHeight="56" WindowStyle="None"
        ResizeMode="NoResize" Background="#F9FBFE" Foreground="#253147" FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="Manual"
        PreviewKeyDown="OnKeyDown" Closing="OnClosing" Loaded="OnLoaded" Deactivated="OnDeactivated">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Focusable" Value="True"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#46556B"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#E4EBF6"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#2466D1"/><Setter TargetName="B" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="Tag" Value="Selected"><Setter TargetName="B" Property="Background" Value="#DDE9FD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- 快捷/完整界面切换：细线 chevron，默认无底，避免再做成工具条按钮。 -->
    <Style x:Key="SwitchIconButton" TargetType="Button">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#8A94A6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="SnapsToDevicePixels" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#E8EEF6"/>
                <Setter Property="Foreground" Value="#4E5A6C"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#D9E2EE"/>
                <Setter Property="Foreground" Value="#3D4858"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SwitchChevron" TargetType="Path">
      <Setter Property="Width" Value="11"/>
      <Setter Property="Height" Value="5"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Fill" Value="Transparent"/>
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="StrokeThickness" Value="1.4"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
  </Window.Resources>
  <Border x:Name="ShellBorder" BorderBrush="#CED7E6" BorderThickness="1" CornerRadius="10" Background="#F9FBFE"
          MouseLeftButtonDown="OnDrag">
    <Grid Background="Transparent">
      <Grid Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Grid.ColumnSpan="2" Margin="16,8,8,0" Visibility="Collapsed" Background="Transparent" MouseLeftButtonDown="OnDrag">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock x:Name="BrandText" Text="QBOX" FontFamily="Bahnschrift" FontWeight="SemiBold" FontSize="15" Foreground="#2466D1" VerticalAlignment="Center"/>
            <TextBlock Text="文件 · 应用" FontSize="12" Foreground="#8490A3" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <Button x:Name="CollapseQuickButton" Grid.Column="1" Style="{StaticResource SwitchIconButton}" Margin="0,0,12,0"
                  VerticalAlignment="Center" Click="OnCollapseToQuick" ToolTip="快捷窗口" AutomationProperties.Name="回到快捷窗口">
            <Path Style="{StaticResource SwitchChevron}" Data="M1,1 L6,5 L11,1"/>
          </Button>
          <Button x:Name="MenuButton" Grid.Column="2" Content="☰" FontSize="16" Width="32" Height="32" Padding="0" Click="OnMenu" ToolTip="设置与索引" AutomationProperties.Name="设置与索引"/>
          <Button Grid.Column="3" Content="×" FontSize="18" Width="32" Height="32" Padding="0" Click="OnHide" ToolTip="收起 · Esc" AutomationProperties.Name="收起搜索栏"/>
        </Grid>
        <Border x:Name="Navigation" Grid.Row="1" Grid.RowSpan="3" Background="#F2F5FA" BorderBrush="#E2E8F1" BorderThickness="0,0,1,0" Visibility="Collapsed">
          <DockPanel Margin="8,8,8,12">
            <Button x:Name="SettingsNav" DockPanel.Dock="Bottom" Content="⚙  设置" Tag="Settings" Click="OnNavigate" Style="{StaticResource NavButton}"/>
            <StackPanel>
              <Button Content="⌕  搜索" Tag="Search" Click="OnNavigate" Style="{StaticResource NavButton}"/>
              <Button Content="▤  剪贴板" Tag="Clipboard" Click="OnNavigate" Style="{StaticResource NavButton}"/>
              <Button Content="▣  截图与贴图" Tag="Capture" Click="OnNavigate" Style="{StaticResource NavButton}"/>
              <Button Content="▦  桌面整理" Tag="Desktop" Click="OnNavigate" Style="{StaticResource NavButton}"/>
              <Button Content="文  翻译" Tag="Translate" Click="OnNavigate" Style="{StaticResource NavButton}"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <ContentControl x:Name="ToolHost" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed"/>
        <Grid x:Name="SearchBar" Grid.Column="1" Grid.Row="1" Margin="16,8,16,8" MinHeight="44" Background="Transparent" MouseLeftButtonDown="OnDrag">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="QueryBox" BorderThickness="0" Background="Transparent" FontSize="20" Foreground="#253147"
                   Padding="2,6,8,6" VerticalContentAlignment="Center" TextChanged="OnQueryChanged"
                   AutomationProperties.Name="搜索文件、文件夹和应用" SpellCheck.IsEnabled="False"/>
          <TextBlock Text="搜索文件、文件夹和应用" FontSize="20" Foreground="#A8B2C1" VerticalAlignment="Center" Margin="2,0,8,0" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <!-- 跳转箭头放在搜索行右侧原关闭按钮位置，避免再叠到卡片顶边把高度撑开。 -->
          <Button x:Name="ExpandFullButton" Grid.Column="1" Style="{StaticResource SwitchIconButton}" VerticalAlignment="Center"
                  Click="OnExpandToFull" ToolTip="完整界面" AutomationProperties.Name="打开完整界面">
            <Path Style="{StaticResource SwitchChevron}" Data="M1,5 L6,1 L11,5"/>
          </Button>
        </Grid>
        <Grid x:Name="ResultsPane" Grid.Column="1" Grid.Row="2" Margin="8,0,8,8" Visibility="Collapsed">
          <ListBox x:Name="Results" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                   MouseDoubleClick="OnResultDoubleClick" PreviewMouseLeftButtonDown="OnResultPreviewMouseLeftButtonDown"
                   PreviewMouseLeftButtonUp="OnResultPreviewMouseLeftButtonUp" SelectionMode="Single" AutomationProperties.Name="搜索结果">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#EDF2F9"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#DDE9FD"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid MinHeight="40" ToolTip="{Binding Target}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MinWidth="48"/>
                  </Grid.ColumnDefinitions>
                  <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                  <Grid Grid.Column="1" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <local:HighlightedText SourceText="{Binding Name}" Highlights="{Binding Highlights}" FontSize="15"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="{Binding Target}" Foreground="#778399" FontSize="12"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,1,0,0"/>
                  </Grid>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,0,0">
                    <TextBlock Text="{Binding KeyHint}" Foreground="#8D99AC" FontSize="12" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding HistoryHint}" Foreground="#4E7DC2" FontSize="11" HorizontalAlignment="Right"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,16">
            <Image Source="{StaticResource AppIcon}" Width="40" Height="40" Margin="0,0,0,14" Opacity="0.75"/>
            <TextBlock x:Name="EmptyTitle" Text="正在准备搜索" FontSize="16" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock x:Name="EmptyDetail" Text="首次载入后，索引会留在内存中。" FontSize="12" Foreground="#8490A3" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480"/>
            <Button x:Name="BuildButton" Content="建立索引" Margin="0,16,0,0" Padding="14,6" Foreground="#2466D1" Background="#E9F0FF" Click="OnUpdate" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>
        <Border x:Name="StatusBar" Grid.Column="1" Grid.Row="3" BorderBrush="#E2E8F1" BorderThickness="0,1,0,0" Background="#F0F4FA" MinHeight="32" Visibility="Collapsed">
          <Grid Margin="16,6,10,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="载入索引…" Foreground="#748198" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="HotkeyText" Grid.Column="1" Text="双击 Ctrl" FontSize="12" Foreground="#70809A" VerticalAlignment="Center" Margin="10,0,2,0"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
